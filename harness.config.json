{
  "runs_dir": "runs",
  "lessons": {
    "file": "LESSONS.md",
    "archive": "docs/archive/lessons_archive.md",
    "max": 12
  },
  "steps": [
    {
      "name": "invariants",
      "type": "command",
      "cmd": ["python3", "tools/check_invariants.py"]
    },
    {
      "name": "tests",
      "type": "command",
      "cmd": ["./gradlew", ":app:testDebugUnitTest"]
    },
    {
      "name": "capture",
      "type": "command",
      "cmd": ["python3", "tools/capture.py"],
      "artifacts": ["runs/shots/bottom_bar.png"]
    },
    {
      "name": "visual",
      "type": "visual",
      "baseline": "runs/baselines/bottom_bar.png",
      "current": "runs/shots/bottom_bar.png",
      "threshold": 8,
      "target_w": 160,
      "stable": 0.05,
      "major": 0.20
    },
    {
      "name": "memory",
      "type": "command",
      "cmd": ["python3", "tools/harness_reflect.py", "audit"]
    }
  ]
}
