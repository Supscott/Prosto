---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ThumbReach from '../components/ThumbReach.astro';
import FeaturesBento from '../components/FeaturesBento.astro';
import TechSpecs from '../components/TechSpecs.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Prosto — The Thumb-First Android Browser" 
  description="Prosto is a calm, private Android browser designed for one hand. Search, switch tabs, and browse from a dock that stays within your thumb's reach."
>
  <Navbar />
  <main>
    <Hero />
    <ThumbReach />
    <FeaturesBento />
    <TechSpecs />
    <DownloadSection />
  </main>
  <Footer />
</Layout>
