---
---

<div class="relative w-full max-w-lg mx-auto flex flex-col items-center">
  <!-- Interactive Scenario Controller Pills -->
  <div class="w-full flex items-center justify-start sm:justify-center gap-1 p-1 mb-3 bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-xl overflow-x-auto no-scrollbar">
    <button 
      type="button" 
      data-scenario="dock" 
      aria-pressed="true" class="scenario-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 whitespace-nowrap bg-[#2271B3] text-white"
    >
      <span>Home</span>
    </button>
    <button 
      type="button" 
      data-scenario="carousel" 
      aria-pressed="false" class="scenario-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 whitespace-nowrap text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card-elevated)]"
    >
      <span>Search</span>
    </button>
    <button 
      type="button" 
      data-scenario="shortcuts" 
      aria-pressed="false" class="scenario-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 whitespace-nowrap text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card-elevated)]"
    >
      <span>Shortcuts</span>
    </button>
    <button 
      type="button" 
      data-scenario="shield" 
      aria-pressed="false" class="scenario-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 whitespace-nowrap text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card-elevated)]"
    >
      <span>Privacy</span>
    </button>
  </div>

  <!-- Phone Mockup Container (Responsive max-w to prevent 320px overflow) -->
  <div class="relative w-full max-w-[330px] h-[620px] bg-[#10192d] rounded-[38px] p-2.5 border border-white/15 shadow-[0_24px_64px_-36px_rgba(0,0,0,0.8)] select-none sm:max-w-[360px]">
    <!-- Camera punch hole -->
    <div class="absolute top-4 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#080f1d] border border-white/10 z-40 flex items-center justify-center">
      <div class="w-1.5 h-1.5 rounded-full bg-slate-950"></div>
    </div>

    <!-- Phone Inner Display Canvas (Adheres to Serene Canvas Tokens) -->
    <div class="relative w-full h-full bg-[var(--bg-canvas)] rounded-[30px] overflow-hidden flex flex-col justify-between border border-[var(--border-subtle)] text-[var(--text-primary)] transition-colors duration-200">
      
      <!-- Top Status Bar -->
      <div class="h-8 px-5 pt-2 flex items-center justify-between text-[10px] text-[var(--text-secondary)] font-mono z-30">
        <span>09:41</span>
        <div class="flex items-center gap-1.5 text-xs">
          <span>5G</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 18.25C3.52 16.51 3 14.33 3 12c0-4.97 4.03-9 9-9s9 4.03 9 9c0 2.33-.52 4.51-1.35 6.25l-.62-.64C20.26 16.07 21 14.12 21 12c0-4.97-4.03-9-9-9zm0 4c-2.76 0-5 2.24-5 5 0 1.18.41 2.27 1.09 3.13l.73-.73C8.3 13.82 8 12.95 8 12c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .95-.3 1.82-.82 2.4l.73.73C16.59 14.27 17 13.18 17 12c0-2.76-2.24-5-5-5zm0 4c-.55 0-1 .45-1 1 0 .28.11.53.29.71l.71-.71.71.71c.18-.18.29-.43.29-.71 0-.55-.45-1-1-1z"/></svg>
          <div class="w-5 h-2.5 rounded-sm border border-[var(--text-muted)] p-0.5 flex items-center">
            <div class="w-full h-full bg-[var(--text-primary)] rounded-2xs"></div>
          </div>
        </div>
      </div>

      <!-- MAIN SIMULATOR DISPLAY BODY -->
      <div class="flex-1 relative flex flex-col px-3.5 py-2 overflow-hidden justify-between">
        
        <!-- SCENARIO 1: HOME & DOCK GESTURE -->
        <div id="sim-view-dock" class="sim-screen flex-1 flex flex-col gap-3 py-2">
          <div class="text-[22px] font-medium tracking-tight">Where to next?</div>
          <button type="button" id="gesture-trigger-card" class="flex h-12 w-full items-center gap-3 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-card)] px-4 text-left text-sm text-[var(--text-muted)] transition-colors hover:border-[var(--brand-accent)]">
            <svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m16 16 4 4"/></svg>
            <span class="truncate">Search with DuckDuckGo</span><span class="ml-auto text-xs">⌕</span>
          </button>

          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3.5">
            <div class="mb-3 flex items-center gap-2 text-sm font-medium"><span class="grid size-7 place-items-center rounded-lg bg-[var(--bg-card-elevated)] text-[var(--brand-accent)]">✓</span> Protection active</div>
            <div class="grid grid-cols-2 gap-2">
              <div class="rounded-xl bg-[var(--bg-card-elevated)] px-3 py-2"><div class="font-mono-code text-lg text-[var(--brand-accent)]">19</div><div class="text-[10px] text-[var(--text-muted)]">Ads blocked</div></div>
              <div class="rounded-xl bg-[var(--bg-card-elevated)] px-3 py-2"><div class="font-mono-code text-lg text-[var(--brand-accent)]">26</div><div class="text-[10px] text-[var(--text-muted)]">Trackers stopped</div></div>
            </div>
          </div>

          <div>
            <div class="mb-2 text-sm font-medium">Favorites</div>
            <div class="flex items-center gap-3 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3">
              <div class="grid size-10 place-items-center rounded-xl bg-[var(--bg-card-elevated)] text-sm font-bold text-[var(--brand-accent)]">▶</div><span class="text-xs">YouTube</span>
              <div class="grid size-10 place-items-center rounded-xl border border-dashed border-[var(--border-subtle)] text-lg text-[var(--brand-accent)]">+</div><span class="text-xs text-[var(--text-muted)]">Add</span>
            </div>
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between text-sm font-medium">Recently closed <span class="text-xs font-normal text-[var(--text-muted)]">1 tab</span></div>
            <div class="flex gap-2">
              <div class="flex-1 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3"><div class="mb-2 h-12 rounded-lg bg-[var(--bg-card-elevated)]"></div><div class="truncate text-xs">Create custom games…</div><div class="mt-1 text-[10px] text-[var(--text-muted)]">blog.google · Just now</div></div>
              <div class="flex w-[72px] flex-col items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] text-xs text-[var(--brand-accent)]">→<span class="mt-1 text-[var(--text-muted)]">More</span></div>
            </div>
          </div>
        </div>

        <!-- SCENARIO 2: CAROUSEL PROVIDERS -->
        <div id="sim-view-carousel" class="sim-screen hidden flex-1 flex flex-col justify-start pt-4 gap-4">
          <div class="text-center">
            <span class="text-[11px] font-mono text-[#2271B3] dark:text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2 py-0.5 rounded-full font-semibold">
              HORIZONTAL FLING CAROUSEL
            </span>
            <p class="text-xs text-[var(--text-muted)] mt-2">Scroll or tap to switch search engine instantly:</p>
          </div>

          <!-- Carousel selector strip -->
          <div class="w-full bg-[var(--bg-card)] border border-[var(--border-card)] rounded-2xl p-2 shadow-inner">
        <div id="engine-carousel-track" class="flex items-center justify-between gap-1 overflow-x-auto no-scrollbar py-1" aria-label="Search engines">
              <button 
                type="button" 
                data-engine="google" aria-pressed="true"
                class="carousel-engine-btn px-2.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-[#2271B3] text-white scale-110 shadow-md flex items-center gap-1.5 opacity-100"
              >
                <span class="engine-dot w-2 h-2 rounded-full bg-white shrink-0"></span>
                <span>Google</span>
              </button>
              <button 
                type="button" 
                data-engine="ddg" aria-pressed="false"
                class="carousel-engine-btn px-2.5 py-1.5 rounded-xl text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-all opacity-60 flex items-center gap-1.5"
              >
                <span class="engine-dot w-2 h-2 rounded-full bg-white shrink-0 hidden"></span>
                <span>DuckDuckGo</span>
              </button>
              <button 
                type="button" 
                data-engine="bing" aria-pressed="false"
                class="carousel-engine-btn px-2.5 py-1.5 rounded-xl text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-all opacity-60 flex items-center gap-1.5"
              >
                <span class="engine-dot w-2 h-2 rounded-full bg-white shrink-0 hidden"></span>
                <span>Bing</span>
              </button>
              <button 
                type="button" 
                data-engine="kagi" aria-pressed="false"
                class="carousel-engine-btn px-2.5 py-1.5 rounded-xl text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-all opacity-60 flex items-center gap-1.5"
              >
                <span class="engine-dot w-2 h-2 rounded-full bg-white shrink-0 hidden"></span>
                <span>Kagi</span>
              </button>
            </div>
          </div>

          <!-- Live query preview -->
          <div class="bg-[var(--bg-card)] border border-[var(--border-card)] rounded-2xl p-3 shadow-sm">
            <div class="text-[11px] text-[var(--text-muted)] mb-1 flex items-center justify-between">
              <span>Active Destination</span>
              <span id="active-engine-badge" class="font-mono text-[#2271B3] dark:text-sky-400 font-bold">google.com/search</span>
            </div>
            <div class="text-xs font-mono text-[var(--text-primary)] bg-[var(--bg-card-elevated)] p-2 rounded-xl border border-[var(--border-subtle)]" id="query-url-preview">
              https://www.google.com/search?q=kotlin+jetpack+compose
            </div>
          </div>

          <div class="text-[11px] text-[var(--text-muted)] text-center italic">
            Zero menus. No dropdowns. Just a continuous thumb fling.
          </div>
        </div>

        <!-- SCENARIO 3: SHORTCUTS -->
        <div id="sim-view-shortcuts" class="sim-screen hidden flex-1 flex flex-col justify-start pt-3 gap-3">
          <div class="text-center">
            <span class="text-[11px] font-mono text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-full font-semibold">
              TERMINAL-SPEED SHORTCUTS
            </span>
            <p class="text-xs text-[var(--text-muted)] mt-2">Type letter prefixes like Raycast / Alfred:</p>
          </div>

          <!-- Shortcut quick clickers -->
          <div id="shortcuts-button-group" class="flex items-center justify-center gap-1.5">
            <button type="button" data-key="g" class="shortcut-key-btn bg-[var(--bg-card)] hover:bg-[var(--bg-card-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] px-2.5 py-1 rounded-xl text-xs font-mono font-bold flex items-center gap-1">
              <span class="text-[#2271B3] dark:text-sky-400">g</span> <span class="text-[var(--text-muted)] text-[10px]">Google</span>
            </button>
            <button type="button" data-key="d" class="shortcut-key-btn bg-[var(--bg-card)] hover:bg-[var(--bg-card-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] px-2.5 py-1 rounded-xl text-xs font-mono font-bold flex items-center gap-1">
              <span class="text-amber-500">d</span> <span class="text-[var(--text-muted)] text-[10px]">DDG</span>
            </button>
            <button type="button" data-key="b" class="shortcut-key-btn bg-[var(--bg-card)] hover:bg-[var(--bg-card-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] px-2.5 py-1 rounded-xl text-xs font-mono font-bold flex items-center gap-1">
              <span class="text-blue-500">b</span> <span class="text-[var(--text-muted)] text-[10px]">Bing</span>
            </button>
            <button type="button" data-key="k" class="shortcut-key-btn bg-[var(--bg-card)] hover:bg-[var(--bg-card-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] px-2.5 py-1 rounded-xl text-xs font-mono font-bold flex items-center gap-1">
              <span class="text-orange-500">k</span> <span class="text-[var(--text-muted)] text-[10px]">Kagi</span>
            </button>
          </div>

          <!-- Simulated omnibox input -->
          <div class="w-full bg-[var(--bg-card)] border-2 border-[#2271B3] dark:border-sky-500 rounded-full px-3.5 py-2 flex items-center gap-2 shadow-md">
            <span id="active-shortcut-pill" class="px-2 py-0.5 rounded-full bg-sky-500/20 text-[#2271B3] dark:text-sky-300 font-mono font-bold text-xs shrink-0">
              g
            </span>
            <input 
              id="sim-input-box" 
              type="text" 
              value="g android 15 features" 
              aria-label="Search or shortcut input"
              class="w-full bg-transparent text-xs text-[var(--text-primary)] focus:outline-none font-mono"
            />
            <span class="text-[10px] text-[var(--text-muted)] font-mono shrink-0">↵ Enter</span>
          </div>

          <div class="bg-[var(--bg-card-elevated)] border border-[var(--border-subtle)] rounded-xl p-2.5 text-xs text-[var(--text-secondary)]">
            <div class="flex items-center gap-1.5 text-[#2271B3] dark:text-sky-400 font-semibold mb-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span>Auto-Prefix Match</span>
            </div>
            <p class="text-[11px] text-[var(--text-muted)]">Custom engines supported: configure any search engine URL template with %s in Settings.</p>
          </div>
        </div>

        <!-- SCENARIO 4: SHIELD STATS -->
        <div id="sim-view-shield" class="sim-screen hidden flex-1 flex flex-col justify-start pt-3 gap-3">
          <div class="text-center">
            <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full font-semibold">
              BUILT-IN SILENT SHIELD
            </span>
            <p class="text-xs text-[var(--text-muted)] mt-2">Zero tracking. No ads. 100% clean canvas.</p>
          </div>

          <!-- Privacy Protection Card (Serene Canvas style) -->
          <div class="w-full bg-[var(--bg-card)] border border-[var(--border-card)] rounded-2xl p-3 shadow-md">
            <div class="flex items-center justify-between mb-2.5">
              <div class="flex items-center gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-400"></div>
                <span class="text-xs font-bold text-[var(--text-primary)]">Privacy Protection</span>
              </div>
              <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20 font-semibold">
                ACTIVE
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div class="bg-[var(--bg-card-elevated)] p-2 rounded-xl border border-[var(--border-subtle)] text-center">
                <div id="stat-ads-count" class="text-base font-extrabold text-[#2271B3] dark:text-sky-400 font-mono">1,482</div>
                <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-semibold">Ads Blocked</div>
              </div>
              <div class="bg-[var(--bg-card-elevated)] p-2 rounded-xl border border-[var(--border-subtle)] text-center">
                <div id="stat-trackers-count" class="text-base font-extrabold text-indigo-600 dark:text-indigo-400 font-mono">419</div>
                <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-semibold">Trackers Stopped</div>
              </div>
            </div>
          </div>

          <div class="bg-[var(--bg-card-elevated)] border border-[var(--border-subtle)] rounded-xl p-2.5 text-[11px] text-[var(--text-muted)] space-y-1">
            <div class="flex items-center gap-1.5 text-[var(--text-primary)] font-semibold">
              <span class="text-emerald-500 font-bold">✓</span> Smart Blocked Responses
            </div>
            <p class="text-[10px] text-[var(--text-muted)]">Returns transparent 1×1 PNGs and 204 No Content stubs instead of 0-byte failures, preventing player freezes.</p>
          </div>
        </div>

      </div>

      <!-- BOTTOM SERENE CANVAS DOCK BAR -->
      <div class="px-2 pb-3 pt-1 z-30">
        <div 
          id="interactive-bottom-dock" 
          role="group" aria-label="Interactive browser dock"
          class="serene-dock rounded-full px-2 py-1.5 flex items-center justify-between gap-1.5 cursor-pointer hover:border-[#60A5FA] transition-all group"
        >
          <!-- Active Tab Capsule -->
          <button type="button" id="dock-search-trigger" aria-label="Open search" class="serene-pill-active flex items-center gap-2 px-3 py-1.5 rounded-full flex-1 min-w-0 text-left">
            <span class="w-2 h-2 rounded-full bg-[#2271B3] dark:bg-sky-400 shrink-0"></span>
            <span id="active-dock-tab-title" class="text-xs font-bold text-[var(--text-primary)] truncate">Prosto Browser</span>
            <span class="text-[10px] font-mono text-[var(--text-muted)] ml-auto">tab 1</span>
          </button>

          <!-- Inactive Tab Pill -->
          <div class="flex items-center px-2 py-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] text-xs truncate max-w-[65px]">
            <span>GitHub</span>
          </div>

          <!-- New Tab Plus Action -->
          <button 
            type="button" 
            id="dock-plus-btn" 
            title="Open New Tab"
            aria-label="Open New Tab"
            class="w-7 h-7 rounded-full bg-[#2271B3]/20 hover:bg-[#2271B3] text-[#2271B3] dark:text-sky-300 hover:text-white flex items-center justify-center font-bold text-sm transition-colors shrink-0"
          >
            +
          </button>
        </div>
        
        <!-- Home Navigation Indicator Bar -->
        <div class="w-28 h-1 bg-[var(--text-muted)]/30 rounded-full mx-auto mt-2"></div>
      </div>

    </div>
  </div>

  <!-- Dynamic Explanation Box Below Simulator -->
  <div class="mt-4 w-full bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl p-3.5 text-center text-xs text-[var(--text-secondary)] shadow-sm">
    <div id="scenario-explanation" class="font-medium text-[var(--text-primary)]">
      <span class="text-[#2271B3] dark:text-sky-400 font-bold">1-Swipe New Tab:</span> Drag or click the bottom dock upwards. Opens a fresh tab and places your cursor directly in search in a single fluid gesture.
    </div>
  </div>
</div>

<script>
  // Interactive Simulator Logic
  const scenarioBtns = document.querySelectorAll('.scenario-pill');
  const screens = {
    dock: document.getElementById('sim-view-dock'),
    carousel: document.getElementById('sim-view-carousel'),
    shortcuts: document.getElementById('sim-view-shortcuts'),
    shield: document.getElementById('sim-view-shield')
  };

  const explanations = {
    dock: '<span class="text-[#2271B3] dark:text-sky-400 font-bold">1-Swipe New Tab:</span> Drag or tap the bottom dock. In 1 thumb gesture, you open a fresh tab with search focused. No more reaching for top corners.',
    carousel: '<span class="text-[#2271B3] dark:text-sky-400 font-bold">Engine Carousel:</span> Horizontal flick across the search bar switches between Google, DuckDuckGo, Bing, Kagi, or custom providers.',
    shortcuts: '<span class="text-amber-600 dark:text-amber-400 font-bold">Prefix Shortcuts:</span> Type "g " for Google, "d " for DDG, "b " for Bing. Power-user workflow without leaving your keyboard.',
    shield: '<span class="text-emerald-600 dark:text-emerald-400 font-bold">Silent Shield:</span> Built-in tracker and ad interception with smart surrogates. Clean home screen statistics.'
  };

  function switchScenario(target) {
    scenarioBtns.forEach(btn => {
      const isTarget = btn.getAttribute('data-scenario') === target;
      btn.setAttribute('aria-pressed', String(isTarget));
      if (isTarget) {
        btn.className = "scenario-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 whitespace-nowrap bg-[#2271B3] text-white";
      } else {
        btn.className = "scenario-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 whitespace-nowrap text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card-elevated)]";
      }
    });

    Object.keys(screens).forEach(key => {
      if (screens[key]) {
        if (key === target) {
          screens[key].classList.remove('hidden');
        } else {
          screens[key].classList.add('hidden');
        }
      }
    });

    const explanationEl = document.getElementById('scenario-explanation');
    if (explanationEl && explanations[target]) {
      explanationEl.innerHTML = explanations[target];
    }
  }

  scenarioBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-scenario');
      if (mode) switchScenario(mode);
    });
  });

  // Dock click / gesture trigger
  const dock = document.getElementById('interactive-bottom-dock');
  const dockSearchTrigger = document.getElementById('dock-search-trigger');
  const triggerCard = document.getElementById('gesture-trigger-card');
  const plusBtn = document.getElementById('dock-plus-btn');

  function openSearchMode() {
    switchScenario('carousel');
  }

  if (dock) {
    let touchStartY = null;
    dock.addEventListener('pointerdown', (event) => {
      touchStartY = event.clientY;
    });
    dock.addEventListener('pointerup', (event) => {
      if (touchStartY !== null && touchStartY - event.clientY > 24) openSearchMode();
      touchStartY = null;
    });
    dock.addEventListener('pointercancel', () => { touchStartY = null; });
  }
  if (dockSearchTrigger) dockSearchTrigger.addEventListener('click', openSearchMode);
  if (triggerCard) {
    triggerCard.addEventListener('click', openSearchMode);
    let touchStartY = null;
    triggerCard.addEventListener('pointerdown', (event) => { touchStartY = event.clientY; });
    triggerCard.addEventListener('pointerup', (event) => {
      if (touchStartY !== null && touchStartY - event.clientY > 24) openSearchMode();
      touchStartY = null;
    });
    triggerCard.addEventListener('pointercancel', () => { touchStartY = null; });
  }
  if (plusBtn) {
    plusBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openSearchMode();
    });
  }

  // Engine Carousel switching with Event Delegation & Indicator Dot Sync
  const carouselTrack = document.getElementById('engine-carousel-track');
  const engineBadge = document.getElementById('active-engine-badge');
  const queryUrlPreview = document.getElementById('query-url-preview');

  const engineUrls = {
    google: { badge: 'google.com/search', url: 'https://www.google.com/search?q=kotlin+jetpack+compose' },
    ddg: { badge: 'duckduckgo.com', url: 'https://duckduckgo.com/?q=android+room+sqlite' },
    bing: { badge: 'bing.com/search', url: 'https://www.bing.com/search?q=kotlinx+coroutines+flow' },
    kagi: { badge: 'kagi.com/search', url: 'https://kagi.com/search?q=serene+canvas+design' }
  };

  function selectEngine(btn) {
    const eng = btn.getAttribute('data-engine');
    if (!eng || !engineUrls[eng]) return;
    const allBtns = carouselTrack.querySelectorAll('.carousel-engine-btn');
    allBtns.forEach((item) => {
      const selected = item === btn;
      item.setAttribute('aria-pressed', String(selected));
      const dot = item.querySelector('.engine-dot');
      if (selected) {
        item.className = "carousel-engine-btn px-2.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-[#2271B3] text-white scale-110 shadow-md flex items-center gap-1.5 opacity-100";
        if (dot) dot.classList.remove('hidden');
      } else {
        item.className = "carousel-engine-btn px-2.5 py-1.5 rounded-xl text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-all opacity-60 flex items-center gap-1.5";
        if (dot) dot.classList.add('hidden');
      }
    });
    if (engineBadge) engineBadge.innerText = engineUrls[eng].badge;
    if (queryUrlPreview) queryUrlPreview.innerText = engineUrls[eng].url;
  }

  if (carouselTrack) {
    carouselTrack.addEventListener('click', (e) => {
      const btn = e.target.closest('.carousel-engine-btn');
      if (!btn) return;
      selectEngine(btn);
    });
    let scrollFrame = 0;
    carouselTrack.addEventListener('scroll', () => {
      if (scrollFrame) cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => {
        const trackCenter = carouselTrack.getBoundingClientRect().left + carouselTrack.clientWidth / 2;
        const nearest = [...carouselTrack.querySelectorAll('.carousel-engine-btn')]
          .reduce((best, btn) => Math.abs(btn.getBoundingClientRect().left + btn.offsetWidth / 2 - trackCenter) < Math.abs(best.getBoundingClientRect().left + best.offsetWidth / 2 - trackCenter) ? btn : best);
        if (nearest) selectEngine(nearest);
      });
    }, { passive: true });
  }

  // Shortcuts keys with Event Delegation
  const shortcutsGroup = document.getElementById('shortcuts-button-group');
  const shortcutPill = document.getElementById('active-shortcut-pill');
  const inputBox = document.getElementById('sim-input-box');

  const shortcutConfigs = {
    g: { text: 'g android 15 features', colorClass: 'bg-sky-500/20 text-[#2271B3] dark:text-sky-300' },
    d: { text: 'd rust token killer rtk', colorClass: 'bg-amber-500/20 text-amber-600 dark:text-amber-300' },
    b: { text: 'b kotlin multiplatform desktop', colorClass: 'bg-blue-500/20 text-blue-600 dark:text-blue-300' },
    k: { text: 'k deepmind agentic coding', colorClass: 'bg-orange-500/20 text-orange-600 dark:text-orange-300' }
  };

  if (shortcutsGroup) {
    shortcutsGroup.addEventListener('click', (e) => {
      const btn = e.target.closest('.shortcut-key-btn');
      if (!btn) return;
      const key = btn.getAttribute('data-key');
      if (key && shortcutConfigs[key]) {
        if (shortcutPill) {
          shortcutPill.innerText = key;
          shortcutPill.className = `px-2 py-0.5 rounded-full font-mono font-bold text-xs shrink-0 ${shortcutConfigs[key].colorClass}`;
        }
        if (inputBox) {
          inputBox.value = shortcutConfigs[key].text;
        }
      }
    });
  }

  // Live typing detector in the input box (with state reset on delete/empty/invalid)
  if (inputBox && shortcutPill) {
    inputBox.addEventListener('input', (e) => {
      const val = e.target.value.trim();
      const firstChar = val.charAt(0).toLowerCase();
      if (shortcutConfigs[firstChar] && (val.charAt(1) === ' ' || val.length === 1)) {
        shortcutPill.innerText = firstChar;
        shortcutPill.className = `px-2 py-0.5 rounded-full font-mono font-bold text-xs shrink-0 ${shortcutConfigs[firstChar].colorClass}`;
      } else {
        shortcutPill.innerText = '🔍';
        shortcutPill.className = 'px-2 py-0.5 rounded-full font-mono font-bold text-xs shrink-0 bg-slate-500/20 text-[var(--text-muted)]';
      }
    });
  }
</script>
