---
---

<section id="download" class="section-rule section-space bg-[#060913]">
  <div class="page-shell">
    
    <div class="relative overflow-hidden rounded-3xl border border-white/15 bg-gradient-to-b from-[#0e1628] to-[#070b14] p-8 sm:p-12 md:p-16 text-center shadow-[0_24px_60px_-15px_rgba(0,0,0,0.8)]">
      
      <!-- Subtle Ambient Glow -->
      <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 size-96 rounded-full bg-[#0284c7]/20 blur-3xl"></div>

      <!-- Badge -->
      <div class="relative z-10 inline-flex items-center gap-2 rounded-full border border-[#38bdf8]/30 bg-[#0a1529] px-4 py-1.5 font-mono text-xs font-semibold text-[#38bdf8] mb-6">
        <span>OFFICIAL RELEASE · v0.1.0</span>
      </div>

      <!-- Headline -->
      <h2 class="relative z-10 max-w-2xl mx-auto text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Ready to browse <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-[#38bdf8] to-[#60a5fa] bg-clip-text text-transparent">
          without friction?
        </span>
      </h2>

      <!-- Subtitle -->
      <p class="relative z-10 mt-4 max-w-xl mx-auto text-slate-300 text-sm sm:text-base leading-relaxed">
        Download the 4.0 MB standalone APK directly from GitHub Releases. 
        Zero account registration, zero telemetry, instant install.
      </p>

      <!-- Action Buttons -->
      <div class="relative z-10 mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="https://github.com/Supscott/browser/releases/download/v0.1.0/prosto-v0.1.0.apk" 
          class="button-primary w-full sm:w-auto min-h-13 px-8 text-sm font-bold tracking-wide"
        >
          <svg class="size-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3v12m0 0 4-4m-4 4-4-4m-4 7v1a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1"/>
          </svg>
          <span>Download Prosto APK (4 MB)</span>
        </a>

        <a 
          href="https://github.com/Supscott/browser/releases" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="button-secondary w-full sm:w-auto min-h-13 px-6 text-sm font-semibold border-white/15"
        >
          <span>All GitHub Releases ↗</span>
        </a>
      </div>

      <!-- Verification Specs Note -->
      <div class="relative z-10 mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-mono text-slate-400">
        <span>Android 8.0+</span>
        <span class="text-white/20">·</span>
        <span>SHA-256 Verified</span>
        <span class="text-white/20">·</span>
        <span>GPL-3.0 License</span>
        <span class="text-white/20">·</span>
        <span>100% Free & Open Source</span>
      </div>

    </div>

  </div>
</section>
