<section id="ergonomics" class="section-rule section-space">
  <div class="page-shell grid items-center gap-10 md:grid-cols-2 md:gap-16">
    <div>
      <p class="eyebrow mb-4">Designed for one hand</p>
      <h2 class="max-w-lg text-3xl font-semibold leading-tight tracking-[-0.04em] sm:text-4xl">Your thumb already knows where to go.</h2>
      <p class="mt-5 max-w-lg leading-7 text-[var(--text-secondary)]">On a big phone, the top edge is a stretch away. Prosto brings the everyday controls down to a natural, comfortable reach.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      <div class="serene-card flex min-h-44 flex-col justify-between rounded-2xl p-5 sm:min-h-52 sm:p-6">
        <span class="text-sm font-medium text-[var(--text-muted)]">Most browsers</span>
        <div class="flex h-28 flex-col justify-between rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-canvas)] p-3">
          <span class="w-2/3 rounded-full bg-[var(--brand-primary)] px-2 py-1 text-center text-[10px] font-semibold text-white">Tabs · Search</span>
          <span class="mx-auto h-12 w-5 rounded-full border border-dashed border-[var(--border-subtle)]"></span>
          <span class="text-center text-[10px] text-[var(--text-muted)]">Content</span>
        </div>
        <span class="text-xs text-[var(--text-secondary)]">Controls at the top</span>
      </div>
      <div class="serene-card flex min-h-44 flex-col justify-between rounded-2xl p-5 sm:min-h-52 sm:p-6">
        <span class="text-sm font-medium text-[var(--text-muted)]">Prosto</span>
        <div class="flex h-28 flex-col justify-between rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-canvas)] p-3">
          <span class="w-2/3 rounded-full bg-[var(--bg-card-elevated)] px-2 py-1 text-center text-[10px] text-[var(--text-muted)]">Content</span>
          <span class="mx-auto h-12 w-5 rounded-full border border-dashed border-[var(--border-subtle)]"></span>
          <span class="rounded-full bg-[var(--brand-primary)] px-2 py-1 text-center text-[10px] font-semibold text-white">Tabs · Search</span>
        </div>
        <span class="text-xs text-[var(--brand-accent)]">Controls at your thumb</span>
      </div>
    </div>
  </div>
</section>
