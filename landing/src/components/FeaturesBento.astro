---
import MediaPlaceholder from './MediaPlaceholder.astro';
---

<section id="features" class="section-rule section-space bg-[#060913]">
  <div class="page-shell">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="eyebrow mb-3">Engineered for Velocity</div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-[1.1]">
        Three unfair advantages. <br />
        <span class="text-slate-400">Zero compromises.</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
        Every interaction that usually takes three taps or two hands is reduced to a single thumb gesture.
      </p>
    </div>

    <!-- 3 Super Bento Cards Grid -->
    <div class="grid gap-8 lg:gap-10">

      <!-- =================================================================== -->
      <!-- SUPER CARD 1: Thumb Dock & Search Swipe -->
      <!-- =================================================================== -->
      <article id="gestures" class="serene-card rounded-3xl p-6 sm:p-10 md:p-12 relative overflow-hidden group">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Text column (5 cols) -->
          <div class="lg:col-span-5 flex flex-col justify-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-[#38bdf8]/30 bg-[#38bdf8]/10 px-3 py-1 font-mono text-xs font-semibold text-[#38bdf8] mb-5 w-fit">
              01 · ERGONOMIC ARCHITECTURE
            </div>
            <h3 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
              Controls at your thumb.<br />
              Not at the ceiling.
            </h3>
            <p class="mt-4 text-slate-300 leading-relaxed text-sm sm:text-base">
              Modern smartphones are 6.7 inches tall, but your thumb only reaches 3 inches comfortably. 
              Prosto moves tabs into an elevated floating dock anchored at the bottom.
            </p>
            <ul class="mt-6 space-y-3 text-sm text-slate-300 font-medium">
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">Floating Dock:</strong> Tabs and URL live right above the nav bar</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">Swipe to Switch Engines:</strong> Swipe across the search field to change providers</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">Zero Climbing:</strong> Never reposition your grip or use a second hand</span>
              </li>
            </ul>

            <div class="mt-8 pt-6 border-t border-white/10 flex items-center gap-4 text-xs font-mono text-slate-400">
              <span class="text-white font-semibold">100% Reachable</span>
              <span>·</span>
              <span>One-Handed Flow</span>
              <span>·</span>
              <span>Spring Physics</span>
            </div>
          </div>

          <!-- Interactive Micro-Demo + Video Placeholder (7 cols) -->
          <div class="lg:col-span-7 flex flex-col md:flex-row gap-6 items-stretch">
            
            <!-- Interactive Swipe Search Simulator Card -->
            <div class="flex-1 rounded-2xl border border-white/10 bg-[#090e1a] p-5 flex flex-col justify-between shadow-inner">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Interactive Playground</span>
                  <span class="rounded bg-white/10 px-2 py-0.5 text-[11px] font-mono text-[#38bdf8]">Test Swipe</span>
                </div>

                <!-- Live Search Engine Swipe Input -->
                <div class="rounded-xl border border-white/15 bg-[#121c2e] p-3 shadow-md mb-4">
                  <div class="text-[11px] font-mono text-slate-400 mb-2">Swipe horizontally or tap to change provider:</div>
                  
                  <!-- Engine selector pills -->
                  <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1">
                    <button type="button" data-engine="ddg" class="engine-swipe-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-[#f97316]/20 border border-[#f97316]/50 text-white flex items-center gap-1.5">
                      <span class="size-2 rounded-full bg-[#f97316]"></span>
                      DuckDuckGo
                    </button>
                    <button type="button" data-engine="google" class="engine-swipe-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white/5 border border-white/10 text-slate-400 hover:text-white flex items-center gap-1.5">
                      <span class="size-2 rounded-full bg-[#4285F4]"></span>
                      Google
                    </button>
                    <button type="button" data-engine="yandex" class="engine-swipe-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white/5 border border-white/10 text-slate-400 hover:text-white flex items-center gap-1.5">
                      <span class="size-2 rounded-full bg-[#fc3f1d]"></span>
                      Yandex
                    </button>
                    <button type="button" data-engine="bing" class="engine-swipe-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white/5 border border-white/10 text-slate-400 hover:text-white flex items-center gap-1.5">
                      <span class="size-2 rounded-full bg-[#008373]"></span>
                      Bing
                    </button>
                  </div>

                  <!-- Dynamic Search Input Display -->
                  <div class="mt-3 flex h-11 w-full items-center gap-2.5 rounded-lg border border-white/15 bg-[#0a101d] px-3 text-xs text-white">
                    <span id="active-engine-badge" class="font-bold text-[#f97316]">DDG:</span>
                    <span id="active-engine-query" class="text-slate-300 truncate">fastest android browser</span>
                    <span class="ml-auto font-mono text-[10px] text-slate-500">Shortcut: 'd '</span>
                  </div>
                </div>

                <!-- Simulated Dock Tabs -->
                <div class="rounded-xl border border-white/15 bg-[#121c2e] p-3 shadow-md">
                  <div class="text-[11px] font-mono text-slate-400 mb-2">Tactile Dock Tabs:</div>
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-9 rounded-full bg-[#1e2c44] border border-[#38bdf8]/40 px-3 flex items-center gap-2 text-xs text-white">
                      <span class="size-2 rounded-full bg-[#38bdf8]"></span>
                      <span class="truncate font-medium">github.com/browser</span>
                    </div>
                    <div class="size-9 rounded-full bg-[#0e1626] border border-white/10 flex items-center justify-center font-mono text-xs text-slate-400">
                      2
                    </div>
                    <div class="size-9 rounded-full bg-[#0e1626] border border-white/10 flex items-center justify-center font-mono text-xs text-slate-400">
                      3
                    </div>
                  </div>
                </div>
              </div>

              <div class="mt-4 text-[11px] font-mono text-slate-400">
                ⚡ Tap providers above to feel the instant zero-latency transition
              </div>
            </div>

            <!-- Video Placeholder for Gesture Screen Recording -->
            <div class="w-full md:w-56 shrink-0 flex flex-col">
              <MediaPlaceholder 
                type="video" 
                label="Dock Gesture Demo" 
                sublabel="360 × 640 px" 
                aspectRatio="9/16"
                className="h-full min-h-[300px]"
              />
            </div>

          </div>

        </div>
      </article>

      <!-- =================================================================== -->
      <!-- SUPER CARD 2: Cross-Engine Comparison (Instant Provider Switcher) -->
      <!-- =================================================================== -->
      <article id="cross-search" class="serene-card rounded-3xl p-6 sm:p-10 md:p-12 relative overflow-hidden group">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Text column (5 cols) -->
          <div class="lg:col-span-5 flex flex-col justify-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-[#38bdf8]/30 bg-[#38bdf8]/10 px-3 py-1 font-mono text-xs font-semibold text-[#38bdf8] mb-5 w-fit">
              02 · CROSS-ENGINE COMPARISON
            </div>
            <h3 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
              Search once.<br />
              Compare anywhere.
            </h3>
            <p class="mt-4 text-slate-300 leading-relaxed text-sm sm:text-base">
              Never get locked in one search engine's algorithm. When you visit any search results URL, 
              Prosto detects your query and floats alternative provider chips directly above the dock.
            </p>
            <ul class="mt-6 space-y-3 text-sm text-slate-300 font-medium">
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">Floating Provider Bar:</strong> Appears directly above your dock on search pages</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">One-Tap Comparison:</strong> Switch from Google to DuckDuckGo or Yandex instantly</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">Zero Retyping:</strong> The exact query string transfers across engines</span>
              </li>
            </ul>

            <div class="mt-8 pt-6 border-t border-white/10 flex items-center gap-4 text-xs font-mono text-slate-400">
              <span class="text-white font-semibold">Query Preserved</span>
              <span>·</span>
              <span>Multi-Source Web</span>
              <span>·</span>
              <span>Customizable List</span>
            </div>
          </div>

          <!-- Dynamic Looping Animation Showcase + Video Placeholder (7 cols) -->
          <div class="lg:col-span-7 flex flex-col md:flex-row gap-6 items-stretch">
            
            <!-- Simulated Search Engine Screen with Dynamic Loop -->
            <div class="flex-1 rounded-2xl border border-white/10 bg-[#090e1a] p-5 flex flex-col justify-between shadow-inner">
              <div>
                <!-- Mockup Header -->
                <div class="flex items-center justify-between mb-3 border-b border-white/10 pb-2">
                  <div class="flex items-center gap-2">
                    <span id="loop-engine-indicator" class="size-2.5 rounded-full bg-[#4285F4] animate-pulse"></span>
                    <span id="loop-engine-name" class="font-bold text-xs text-white">Google Search</span>
                  </div>
                  <span class="font-mono text-[10px] text-slate-400">Query: "fastest android browser"</span>
                </div>

                <!-- Simulated Search Results Container -->
                <div id="simulated-serp" class="rounded-xl border border-white/10 bg-[#070b14] p-3.5 space-y-2.5 min-h-[160px] transition-all duration-300">
                  <div class="flex items-center gap-2">
                    <span id="serp-badge" class="rounded bg-[#4285F4]/20 border border-[#4285F4]/40 px-1.5 py-0.5 text-[10px] font-mono text-[#4285F4]">google.com/search</span>
                    <span class="text-[10px] text-slate-400">About 1,240,000 results (0.18s)</span>
                  </div>
                  <div id="serp-title" class="text-xs font-bold text-[#60a5fa] hover:underline cursor-pointer">
                    Prosto Browser — 4 MB Ultra-Fast Android Browser
                  </div>
                  <div id="serp-desc" class="text-[11px] text-slate-300 leading-relaxed">
                    Designed for one hand with gesture-based bottom dock, EasyList adblocker, and 4 MB installation footprint.
                  </div>
                </div>

                <!-- THE FLOATING PROVIDER ROW (The Star Feature) -->
                <div class="mt-4 pt-3 border-t border-white/10">
                  <div class="text-[10px] font-mono text-[#38bdf8] mb-1.5 uppercase tracking-wider flex items-center justify-between">
                    <span>Floating Switcher Bar (Above Dock):</span>
                    <span class="text-slate-400 lowercase">auto-cycling loop</span>
                  </div>
                  
                  <div id="provider-chips-row" class="flex items-center gap-2 p-1.5 rounded-full bg-[#111a2c] border border-[#38bdf8]/30 shadow-lg">
                    <button type="button" data-chip="google" class="provider-chip flex-1 h-8 rounded-full text-[11px] font-bold flex items-center justify-center gap-1 transition-all bg-[#0284c7] text-white shadow-sm">
                      <span class="size-1.5 rounded-full bg-white"></span>
                      Google
                    </button>
                    <button type="button" data-chip="ddg" class="provider-chip flex-1 h-8 rounded-full text-[11px] font-semibold flex items-center justify-center gap-1 transition-all text-slate-400 hover:text-white hover:bg-white/5">
                      DuckDuckGo
                    </button>
                    <button type="button" data-chip="yandex" class="provider-chip flex-1 h-8 rounded-full text-[11px] font-semibold flex items-center justify-center gap-1 transition-all text-slate-400 hover:text-white hover:bg-white/5">
                      Yandex
                    </button>
                    <button type="button" data-chip="bing" class="provider-chip flex-1 h-8 rounded-full text-[11px] font-semibold flex items-center justify-center gap-1 transition-all text-slate-400 hover:text-white hover:bg-white/5">
                      Bing
                    </button>
                  </div>
                </div>

              </div>

              <!-- Loop Progress Indicator Bar -->
              <div class="mt-4 flex items-center gap-3">
                <div class="flex-1 h-1 rounded-full bg-white/10 overflow-hidden">
                  <div id="loop-progress-bar" class="h-full bg-[#38bdf8] w-0 transition-all duration-100 ease-linear"></div>
                </div>
                <span class="text-[10px] font-mono text-slate-400">Click any chip to jump</span>
              </div>
            </div>

            <!-- Video Placeholder for Switcher In-App Recording -->
            <div class="w-full md:w-56 shrink-0 flex flex-col">
              <MediaPlaceholder 
                type="video" 
                label="Search Switcher" 
                sublabel="360 × 640 px" 
                aspectRatio="9/16"
                className="h-full min-h-[300px]"
              />
            </div>

          </div>

        </div>
      </article>

      <!-- =================================================================== -->
      <!-- SUPER CARD 3: Native AdBlock & 4 MB Zero Bloat -->
      <!-- =================================================================== -->
      <article id="adblock" class="serene-card rounded-3xl p-6 sm:p-10 md:p-12 relative overflow-hidden group">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Text column (5 cols) -->
          <div class="lg:col-span-5 flex flex-col justify-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-[#38bdf8]/30 bg-[#38bdf8]/10 px-3 py-1 font-mono text-xs font-semibold text-[#38bdf8] mb-5 w-fit">
              03 · ARCHITECTURAL PURITY
            </div>
            <h3 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
              No ads. No trackers.<br />
              Just 4 MB.
            </h3>
            <p class="mt-4 text-slate-300 leading-relaxed text-sm sm:text-base">
              Traditional browsers bundle a 200 MB Chromium binary and dozens of analytics SDKs. 
              Prosto uses Android’s hardware-accelerated WebKit and Jetpack Compose, cutting APK size to 4.0 MB.
            </p>
            <ul class="mt-6 space-y-3 text-sm text-slate-300 font-medium">
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">EasyList Engine:</strong> Intercepts ad networks at the socket level</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">0 Third-Party Analytics:</strong> Zero telemetry, zero phone-home calls</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[#0284c7]/30 text-[#38bdf8] text-xs font-bold">✓</span>
                <span><strong class="text-white">Instant Cold Start:</strong> Launches in under 120ms with minimal RAM usage</span>
              </li>
            </ul>

            <div class="mt-8 pt-6 border-t border-white/10 flex items-center gap-4 text-xs font-mono text-slate-400">
              <span class="text-white font-semibold">4.0 MB APK</span>
              <span>·</span>
              <span>2.8x Faster Loads</span>
              <span>·</span>
              <span>Private by Default</span>
            </div>
          </div>

          <!-- Interactive AdBlock Comparison Sandbox + Photo Placeholder (7 cols) -->
          <div class="lg:col-span-7 flex flex-col md:flex-row gap-6 items-stretch">
            
            <!-- Live AdBlock Toggle Sandbox -->
            <div class="flex-1 rounded-2xl border border-white/10 bg-[#090e1a] p-5 flex flex-col justify-between shadow-inner">
              <div>
                <!-- Header with Toggle Button -->
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-white/10">
                  <span class="text-xs font-mono text-slate-300 uppercase tracking-wider">Protection Shield</span>
                  <button 
                    type="button" 
                    id="adblock-toggle-btn"
                    class="px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 transition-all bg-[#0284c7] text-white border border-[#38bdf8]/40 shadow-sm"
                  >
                    <span id="adblock-status-dot" class="size-2 rounded-full bg-[#38bdf8] animate-pulse"></span>
                    <span id="adblock-status-text">AdBlock: ACTIVE</span>
                  </button>
                </div>

                <!-- Live Metrics Display -->
                <div class="grid grid-cols-2 gap-2.5 mb-4">
                  <div class="rounded-xl border border-white/10 bg-[#0e1628] p-3 text-center">
                    <div id="stat-ads" class="text-2xl font-mono font-bold text-[#38bdf8]">42</div>
                    <div class="text-[11px] text-slate-400">Ads neutralized</div>
                  </div>
                  <div class="rounded-xl border border-white/10 bg-[#0e1628] p-3 text-center">
                    <div id="stat-trackers" class="text-2xl font-mono font-bold text-[#60a5fa]">18</div>
                    <div class="text-[11px] text-slate-400">Trackers blocked</div>
                  </div>
                </div>

                <!-- Simulated Page Preview (Clean vs Bloated) -->
                <div id="adblock-preview-box" class="rounded-xl border border-white/10 bg-[#070b14] p-3.5 space-y-2 transition-all">
                  <div class="h-3 w-1/3 rounded bg-white/20"></div>
                  <div class="h-2 w-full rounded bg-white/10"></div>
                  <div class="h-2 w-4/5 rounded bg-white/10"></div>
                  
                  <!-- Dynamic ad banner that appears when AdBlock is toggled OFF -->
                  <div id="simulated-ad-banner" class="hidden rounded-lg border border-red-500/40 bg-red-950/40 p-2 text-center text-xs text-red-300 font-mono">
                    ⚠️ [ADVERTISEMENT] Clutter, popups, and tracker scripts active
                  </div>

                  <div class="h-2 w-2/3 rounded bg-white/10"></div>
                </div>

                <!-- APK Size Comparison Bar -->
                <div class="mt-4 pt-3 border-t border-white/10 space-y-2">
                  <div class="text-[11px] font-mono text-slate-400 flex justify-between">
                    <span>Prosto (4.0 MB)</span>
                    <span class="text-[#38bdf8] font-bold">100% Native</span>
                  </div>
                  <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
                    <div class="h-full bg-[#0284c7] w-[4%] rounded-full"></div>
                  </div>

                  <div class="text-[11px] font-mono text-slate-500 flex justify-between pt-1">
                    <span>Other Browsers (190 - 240 MB)</span>
                    <span class="text-red-400">50x Larger</span>
                  </div>
                  <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
                    <div class="h-full bg-red-500/70 w-[95%] rounded-full"></div>
                  </div>
                </div>
              </div>

              <div class="mt-3 text-[11px] font-mono text-slate-400 text-center">
                Toggle shield to see the contrast in speed and cleanliness
              </div>
            </div>

            <!-- Photo Placeholder for AdBlock Comparison -->
            <div class="w-full md:w-56 shrink-0 flex flex-col">
              <MediaPlaceholder 
                type="photo" 
                label="AdBlock Shield" 
                sublabel="360 × 640 px" 
                aspectRatio="9/16"
                className="h-full min-h-[300px]"
              />
            </div>

          </div>

        </div>
      </article>

    </div>
  </div>
</section>

<script>
  // =========================================================================
  // CARD 1: Search Engine Swipe Playground Script
  // =========================================================================
  const swipeBtns = document.querySelectorAll<HTMLButtonElement>('.engine-swipe-btn');
  const engineBadge = document.getElementById('active-engine-badge');
  const engineQuery = document.getElementById('active-engine-query');

  const engineConfigs: Record<string, { label: string; color: string; query: string; shortcut: string }> = {
    ddg: { label: 'DDG:', color: '#f97316', query: 'fastest android browser', shortcut: "Shortcut: 'd '" },
    google: { label: 'GOOGLE:', color: '#4285F4', query: 'clean android web browser apk', shortcut: "Shortcut: 'g '" },
    yandex: { label: 'YANDEX:', color: '#fc3f1d', query: 'легкий браузер для андроид', shortcut: "Shortcut: 'y '" },
    bing: { label: 'BING:', color: '#008373', query: 'efficient mobile browser without ads', shortcut: "Shortcut: 'b '" },
  };

  swipeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const engineKey = btn.dataset.engine || 'ddg';
      const config = engineConfigs[engineKey];
      if (!config) return;

      // Update button visual states
      swipeBtns.forEach(b => {
        b.className = 'engine-swipe-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white/5 border border-white/10 text-slate-400 hover:text-white flex items-center gap-1.5';
      });
      btn.className = `engine-swipe-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-[${config.color}]/20 border border-[${config.color}]/50 text-white flex items-center gap-1.5`;

      // Update input display
      if (engineBadge) {
        engineBadge.textContent = config.label;
        engineBadge.style.color = config.color;
      }
      if (engineQuery) {
        engineQuery.textContent = config.query;
      }
    });
  });

  // =========================================================================
  // CARD 2: Cross-Engine Switcher Dynamic Looping Animation
  // =========================================================================
  const loopConfigs = [
    {
      key: 'google',
      name: 'Google Search',
      dotColor: '#4285F4',
      badge: 'google.com/search',
      badgeColor: '#4285F4',
      title: 'Prosto Browser — 4 MB Ultra-Fast Android Browser',
      desc: 'Designed for one hand with gesture-based bottom dock, EasyList adblocker, and 4 MB installation footprint.'
    },
    {
      key: 'ddg',
      name: 'DuckDuckGo Search',
      dotColor: '#f97316',
      badge: 'duckduckgo.com/?q=...',
      badgeColor: '#f97316',
      title: 'Prosto Browser: Privacy First, Zero Trackers',
      desc: 'DuckDuckGo results for "fastest android browser". Built-in tracker neutralizer with 0 third-party telemetry.'
    },
    {
      key: 'yandex',
      name: 'Yandex Search',
      dotColor: '#fc3f1d',
      badge: 'yandex.com/search?text=...',
      badgeColor: '#fc3f1d',
      title: 'Prosto: Быстрый браузер для Android без рекламы',
      desc: 'Яндекс поиск: 4 МБ установочный файл, плавающий док внизу экрана и мгновенное переключение поисковиков.'
    },
    {
      key: 'bing',
      name: 'Bing Search',
      dotColor: '#008373',
      badge: 'bing.com/search?q=...',
      badgeColor: '#008373',
      title: 'Prosto Browser on Android — Gesture Navigation',
      desc: 'Bing search query preserved across providers. Instant comparison without retyping the query.'
    }
  ];

  let currentLoopIndex = 0;
  const chipButtons = document.querySelectorAll<HTMLButtonElement>('.provider-chip');
  const loopIndicator = document.getElementById('loop-engine-indicator');
  const loopName = document.getElementById('loop-engine-name');
  const serpBadge = document.getElementById('serp-badge');
  const serpTitle = document.getElementById('serp-title');
  const serpDesc = document.getElementById('serp-desc');
  const progressBar = document.getElementById('loop-progress-bar');

  function renderLoopStep(index: number) {
    const item = loopConfigs[index];
    if (!item) return;

    if (loopIndicator) loopIndicator.style.backgroundColor = item.dotColor;
    if (loopName) loopName.textContent = item.name;
    if (serpBadge) {
      serpBadge.textContent = item.badge;
      serpBadge.style.color = item.badgeColor;
      serpBadge.style.borderColor = `${item.badgeColor}40`;
      serpBadge.style.backgroundColor = `${item.badgeColor}20`;
    }
    if (serpTitle) serpTitle.textContent = item.title;
    if (serpDesc) serpDesc.textContent = item.desc;

    chipButtons.forEach((btn) => {
      const chipKey = btn.dataset.chip;
      if (chipKey === item.key) {
        btn.className = 'provider-chip flex-1 h-8 rounded-full text-[11px] font-bold flex items-center justify-center gap-1 transition-all bg-[#0284c7] text-white shadow-sm';
      } else {
        btn.className = 'provider-chip flex-1 h-8 rounded-full text-[11px] font-semibold flex items-center justify-center gap-1 transition-all text-slate-400 hover:text-white hover:bg-white/5';
      }
    });
  }

  // Allow manual chip click to jump to step
  chipButtons.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      currentLoopIndex = idx;
      renderLoopStep(currentLoopIndex);
      resetProgress();
    });
  });

  // Smooth Loop Timer
  let progress = 0;
  function resetProgress() {
    progress = 0;
    if (progressBar) progressBar.style.width = '0%';
  }

  setInterval(() => {
    progress += 2;
    if (progressBar) progressBar.style.width = `${progress}%`;
    if (progress >= 100) {
      currentLoopIndex = (currentLoopIndex + 1) % loopConfigs.length;
      renderLoopStep(currentLoopIndex);
      resetProgress();
    }
  }, 70);

  // =========================================================================
  // CARD 3: AdBlock Interactive Sandbox Toggle Script
  // =========================================================================
  const adblockBtn = document.getElementById('adblock-toggle-btn');
  const statusDot = document.getElementById('adblock-status-dot');
  const statusText = document.getElementById('adblock-status-text');
  const adBanner = document.getElementById('simulated-ad-banner');
  const statAds = document.getElementById('stat-ads');
  const statTrackers = document.getElementById('stat-trackers');

  let isAdblockOn = true;

  adblockBtn?.addEventListener('click', () => {
    isAdblockOn = !isAdblockOn;
    if (isAdblockOn) {
      adblockBtn.className = 'px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 transition-all bg-[#0284c7] text-white border border-[#38bdf8]/40 shadow-sm';
      if (statusDot) {
        statusDot.className = 'size-2 rounded-full bg-[#38bdf8] animate-pulse';
      }
      if (statusText) statusText.textContent = 'AdBlock: ACTIVE';
      if (adBanner) adBanner.classList.add('hidden');
      if (statAds) statAds.textContent = '42';
      if (statTrackers) statTrackers.textContent = '18';
    } else {
      adblockBtn.className = 'px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 transition-all bg-red-950/60 text-red-200 border border-red-500/50';
      if (statusDot) {
        statusDot.className = 'size-2 rounded-full bg-red-400';
      }
      if (statusText) statusText.textContent = 'AdBlock: DISABLED';
      if (adBanner) adBanner.classList.remove('hidden');
      if (statAds) statAds.textContent = '0';
      if (statTrackers) statTrackers.textContent = '0';
    }
  });
</script>
