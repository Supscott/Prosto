<section id="features" class="section-rule section-space">
  <div class="page-shell">
    <div class="grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
      <div>
        <p class="eyebrow mb-4">Made for the way you hold your phone</p>
        <h2 class="max-w-md text-3xl font-semibold leading-tight tracking-[-0.04em] sm:text-4xl">Less reaching.<br />More browsing.</h2>
      </div>
      <div class="divide-y divide-[var(--border-subtle)] border-y border-[var(--border-subtle)]">
        <article class="grid gap-2 py-5 sm:grid-cols-[48px_1fr] sm:gap-4">
          <span class="font-mono-code text-sm text-[var(--brand-accent)]">01</span>
          <div><h3 class="font-semibold">One swipe to a new tab</h3><p class="mt-1 text-sm leading-6 text-[var(--text-secondary)]">Swipe up from the dock and search is ready. Your tabs stay right where your thumb is.</p></div>
        </article>
        <article class="grid gap-2 py-5 sm:grid-cols-[48px_1fr] sm:gap-4">
          <span class="font-mono-code text-sm text-[var(--brand-accent)]">02</span>
          <div><h3 class="font-semibold">Your search, your choice</h3><p class="mt-1 text-sm leading-6 text-[var(--text-secondary)]">Flick between providers or type a shortcut like <code class="rounded bg-[var(--bg-card-elevated)] px-1.5 py-0.5 font-mono-code text-xs">d cats</code> for DuckDuckGo.</p></div>
        </article>
        <article class="grid gap-2 py-5 sm:grid-cols-[48px_1fr] sm:gap-4">
          <span class="font-mono-code text-sm text-[var(--brand-accent)]">03</span>
          <div><h3 class="font-semibold">A quieter web, by default</h3><p class="mt-1 text-sm leading-6 text-[var(--text-secondary)]">Built-in ad and tracker blocking keeps pages focused and protects your privacy.</p></div>
        </article>
        <article class="grid gap-2 py-5 sm:grid-cols-[48px_1fr] sm:gap-4">
          <span class="font-mono-code text-sm text-[var(--brand-accent)]">04</span>
          <div><h3 class="font-semibold">Light on your phone</h3><p class="mt-1 text-sm leading-6 text-[var(--text-secondary)]">A small install, native Android interface, and thoughtful performance from the start.</p></div>
        </article>
      </div>
    </div>
  </div>
</section>
