---
import MediaPlaceholder from './MediaPlaceholder.astro';
---

<section class="relative overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28 hero-glow-grid border-b border-white/10">
  <div class="page-shell flex flex-col items-center text-center">
    
    <!-- Top Announcement Pill / Eyebrow -->
    <div class="inline-flex items-center gap-2.5 rounded-full border border-[#38bdf8]/30 bg-[#0a1529] px-4 py-1.5 text-xs font-semibold text-[#38bdf8] shadow-[0_0_24px_rgba(56,189,248,0.15)] mb-8">
      <span class="size-2 rounded-full bg-[#38bdf8] animate-pulse"></span>
      <span class="tracking-wide">PROSTO BROWSER · 4 MB · ZERO BLOAT</span>
    </div>

    <!-- Centered Giant Headline -->
    <h1 class="max-w-4xl text-[clamp(2.5rem,6.5vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-0.05em] text-white">
      Every action in a <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-[#38bdf8] via-[#60a5fa] to-[#93c5fd] bg-clip-text text-transparent">
        single swipe.
      </span>
    </h1>

    <!-- Punchy Subtitle -->
    <p class="mt-6 max-w-2xl text-lg sm:text-xl leading-relaxed text-slate-300 font-normal">
      The Android browser engineered for radical efficiency. Your tabs live in a tactile floating dock at your thumb, search engines switch in a swipe, and ads vanish by default.
    </p>

    <!-- Call to Actions -->
    <div class="mt-8 flex flex-col sm:flex-row items-center gap-3.5 w-full sm:w-auto">
      <a 
        href="https://github.com/Supscott/browser/releases/download/v0.1.0/prosto-v0.1.0.apk" 
        class="button-primary w-full sm:w-auto min-h-13 px-7 text-sm font-bold tracking-wide"
      >
        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3v12m0 0 4-4m-4 4-4-4m-4 7v1a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1"/>
        </svg>
        <span>Download APK (v0.1.0 · 4 MB)</span>
      </a>

      <a 
        href="https://github.com/Supscott/browser" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="button-secondary w-full sm:w-auto min-h-13 px-6 text-sm font-semibold border-white/15"
      >
        <svg class="size-5 shrink-0 fill-current opacity-80" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>View Source ↗</span>
      </a>
    </div>

    <!-- Quick Spec Badges (Helium style metrics) -->
    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-5 gap-y-2.5 text-xs font-mono text-slate-400">
      <div class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-[#38bdf8]"></span>
        <span class="text-white font-medium">4.0 MB</span> Uncompressed
      </div>
      <span class="text-white/20">·</span>
      <div class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-[#38bdf8]"></span>
        <span class="text-white font-medium">0ms</span> Thumb Reach
      </div>
      <span class="text-white/20">·</span>
      <div class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-[#38bdf8]"></span>
        <span class="text-white font-medium">EasyList</span> AdBlock
      </div>
      <span class="text-white/20">·</span>
      <div class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-[#38bdf8]"></span>
        <span class="text-white font-medium">Android 8+</span>
      </div>
      <span class="text-white/20">·</span>
      <div class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-[#38bdf8]"></span>
        <span class="text-white font-medium">GPL-3.0</span> Open Source
      </div>
    </div>

    <!-- CENTERPIECE: Elevated Phone Mockup with Interactive Floating Dock -->
    <div class="mt-14 w-full max-w-xl mx-auto flex flex-col items-center">
      
      <!-- Phone Mockup Container -->
      <div class="relative w-full max-w-[360px] sm:max-w-[390px] h-[640px] bg-[#070b14] rounded-[44px] p-3 border border-white/20 shadow-[0_32px_80px_-20px_rgba(0,0,0,0.9),0_0_60px_-15px_rgba(2,132,199,0.25)] select-none flex flex-col justify-between">
        
        <!-- Camera Punch Hole -->
        <div class="absolute top-4 left-1/2 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-[#03060c] border border-white/10 z-40 flex items-center justify-center">
          <div class="w-1.5 h-1.5 rounded-full bg-slate-900"></div>
        </div>

        <!-- Phone Display Screen -->
        <div class="relative w-full h-full bg-[#0a0f1d] rounded-[34px] overflow-hidden flex flex-col justify-between border border-white/10">
          
          <!-- Status Bar -->
          <div class="h-8 px-5 pt-2 flex items-center justify-between text-[11px] text-slate-400 font-mono z-30">
            <span>09:41</span>
            <div class="flex items-center gap-2">
              <span class="text-[10px]">5G</span>
              <div class="w-5 h-2.5 rounded-sm border border-slate-400 p-0.5 flex items-center">
                <div class="w-full h-full bg-white rounded-2xs"></div>
              </div>
            </div>
          </div>

          <!-- Video Placeholder for App Showcase -->
          <div class="flex-1 relative flex flex-col px-3 py-2 overflow-hidden justify-between">
            
            <!-- Video / Screen recording container -->
            <div class="relative flex-1 rounded-2xl overflow-hidden border border-white/10 bg-[#070c18] flex flex-col">
              <MediaPlaceholder 
                type="video" 
                label="Prosto in Action" 
                sublabel="Dock gestures & 4 MB speed demo" 
                aspectRatio="auto"
                height="100%"
                className="w-full h-full border-none rounded-none"
              />
            </div>

            <!-- FLOATING DOCK COMPONENT (Interactive) -->
            <div class="mt-2.5 pt-1 pb-1">
              <!-- Search Trigger Pill directly above dock -->
              <button 
                type="button" 
                id="hero-search-trigger"
                class="w-full mb-2 h-10 px-3.5 rounded-full bg-[#121b2d] border border-white/15 flex items-center gap-2.5 text-xs text-slate-300 transition-all hover:border-[#38bdf8]/40 hover:bg-[#162238] active:scale-[0.99]"
              >
                <div class="grid size-5 place-items-center rounded-full bg-[#0284c7] text-white">
                  <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>
                </div>
                <span class="font-medium text-slate-200">Search or swipe engines...</span>
                <span class="ml-auto font-mono text-[10px] text-slate-400">g, d, y</span>
              </button>

              <!-- Tactile Floating Dock Bar -->
              <div 
                id="hero-floating-dock"
                class="w-full h-[52px] rounded-full bg-[#0e1626] border border-white/15 px-1.5 flex items-center gap-1.5 shadow-[0_12px_28px_rgba(0,0,0,0.8)]"
              >
                <!-- Active Tab Capsule (Dynamically toggled) -->
                <button 
                  type="button" 
                  data-tab="1" 
                  class="hero-dock-tab relative flex-1 h-[42px] px-3 rounded-full bg-[#1e2c44] border border-[#38bdf8]/35 flex items-center gap-2 text-left transition-all duration-200 text-white font-medium text-xs shadow-sm"
                >
                  <span class="grid size-4 shrink-0 place-items-center rounded-full bg-[#0284c7] text-[9px] font-bold text-white">G</span>
                  <span class="truncate tab-title text-xs">github.com</span>
                  <!-- Active Dot -->
                  <span class="ml-auto size-1.5 rounded-full bg-[#38bdf8]"></span>
                </button>

                <!-- Inactive Tab 2 -->
                <button 
                  type="button" 
                  data-tab="2" 
                  class="hero-dock-tab size-[42px] shrink-0 rounded-full bg-[#121c2e] border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-white/20 transition-all text-xs"
                  title="DuckDuckGo"
                >
                  <span class="font-mono font-bold text-xs text-orange-400">D</span>
                </button>

                <!-- Inactive Tab 3 -->
                <button 
                  type="button" 
                  data-tab="3" 
                  class="hero-dock-tab size-[42px] shrink-0 rounded-full bg-[#121c2e] border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-white/20 transition-all text-xs"
                  title="Hacker News"
                >
                  <span class="font-mono font-bold text-xs text-amber-500">Y</span>
                </button>

                <!-- New Tab Button -->
                <button 
                  type="button" 
                  id="hero-new-tab-btn"
                  class="size-[42px] shrink-0 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-slate-300 hover:text-white hover:bg-white/10 transition-all"
                  title="New Tab"
                >
                  <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                </button>
              </div>
            </div>

            <!-- Android Navigation Bar line -->
            <div class="h-4 flex items-center justify-center">
              <div class="w-24 h-1 rounded-full bg-white/25"></div>
            </div>

          </div>
        </div>
      </div>

      <!-- Hint under phone -->
      <p class="mt-4 text-xs font-mono text-slate-400 flex items-center gap-1.5">
        <svg class="size-3.5 text-[#38bdf8]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>
        <span>Interactive mockup: Tap tabs or search pill to test dock ergonomics</span>
      </p>

    </div>

  </div>
</section>

<script>
  // Interactive Tab switching in Hero Mockup
  const tabs = document.querySelectorAll<HTMLButtonElement>('.hero-dock-tab');
  const tabData = [
    { id: '1', title: 'github.com', letter: 'G', color: '#0284c7' },
    { id: '2', title: 'duckduckgo.com', letter: 'D', color: '#f97316' },
    { id: '3', title: 'news.ycombinator.com', letter: 'Y', color: '#eab308' }
  ];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabId = tab.dataset.tab;
      const target = tabData.find(t => t.id === tabId);
      if (!target) return;

      tabs.forEach(t => {
        const id = t.dataset.tab;
        const info = tabData.find(item => item.id === id);
        if (id === tabId) {
          // make active
          t.className = 'hero-dock-tab relative flex-1 h-[42px] px-3 rounded-full bg-[#1e2c44] border border-[#38bdf8]/35 flex items-center gap-2 text-left transition-all duration-200 text-white font-medium text-xs shadow-sm';
          t.innerHTML = `
            <span class="grid size-4 shrink-0 place-items-center rounded-full bg-[${info?.color || '#0284c7'}] text-[9px] font-bold text-white">${info?.letter}</span>
            <span class="truncate tab-title text-xs">${info?.title}</span>
            <span class="ml-auto size-1.5 rounded-full bg-[#38bdf8]"></span>
          `;
        } else {
          // make inactive
          t.className = 'hero-dock-tab size-[42px] shrink-0 rounded-full bg-[#121c2e] border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-white/20 transition-all text-xs';
          t.innerHTML = `<span class="font-mono font-bold text-xs" style="color: ${info?.color}">${info?.letter}</span>`;
        }
      });
    });
  });

  const searchTrigger = document.getElementById('hero-search-trigger');
  searchTrigger?.addEventListener('click', () => {
    const el = document.getElementById('gestures');
    el?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
