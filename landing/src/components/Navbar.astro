---
---

<header class="border-b border-[var(--border-subtle)]">
  <div class="page-shell flex h-[72px] items-center justify-between gap-5">
    <a href="/" class="flex items-center gap-3 text-[var(--text-primary)]" aria-label="Prosto home">
      <span class="grid size-9 place-items-center rounded-xl bg-[var(--brand-primary)] text-sm font-extrabold text-white">P</span>
      <span class="text-lg font-bold tracking-tight">Prosto</span>
      <span class="hidden text-sm text-[var(--text-muted)] sm:inline">for Android</span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-7 text-sm font-medium text-[var(--text-secondary)] md:flex">
      <a href="#features" class="transition-colors hover:text-[var(--text-primary)]">Features</a>
      <a href="#about" class="transition-colors hover:text-[var(--text-primary)]">About</a>
      <a href="https://github.com/Supscott/browser" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--text-primary)]">Source</a>
    </nav>

    <div class="flex items-center gap-2">
      <button id="theme-toggle-btn" type="button" aria-label="Switch color theme" class="grid size-10 place-items-center rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-card-elevated)]">
        <svg class="size-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke-width="1.8"/><path stroke-linecap="round" stroke-width="1.8" d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M6.34 17.66l-1.42 1.42m12.74-12.74 1.42-1.42"/></svg>
      </button>
      <a href="#download" class="button-primary min-h-10 px-4 text-sm">Get Prosto</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle-btn');
  toggle?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('prosto-theme', dark ? 'dark' : 'light');
  });
</script>
