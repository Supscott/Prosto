---
interface Props {
  type: 'photo' | 'video';
  label?: string;
  sublabel?: string;
  aspectRatio?: string;
  width?: string;
  height?: string;
  className?: string;
}

const {
  type,
  label = type === 'video' ? 'Screen Recording' : 'Screenshot',
  sublabel,
  aspectRatio = type === 'video' ? '9/19' : '16/10',
  width = '100%',
  height = 'auto',
  className = '',
} = Astro.props;

const isVideo = type === 'video';
---

<div 
  class={`relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-[#090e1a] text-center select-none group transition-all duration-300 hover:border-[#38bdf8]/40 ${className}`}
  style={{
    aspectRatio: aspectRatio,
    width: width,
    height: height,
  }}
  role="img"
  aria-label={`${type.toUpperCase()} placeholder: ${label}`}
>
  <!-- Background Grid Pattern -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>
  
  <!-- Subtle Glow Accent -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#38bdf8]/5 via-transparent to-[#0284c7]/5"></div>

  <!-- Content Container -->
  <div class="relative z-10 flex flex-col items-center gap-3 p-4">
    <!-- Icon Circle -->
    <div class="grid size-12 place-items-center rounded-xl border border-white/10 bg-white/5 text-[#38bdf8] shadow-inner transition-transform duration-300 group-hover:scale-105 group-hover:border-[#38bdf8]/30">
      {isVideo ? (
        <svg class="size-6 translate-x-0.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/>
        </svg>
      ) : (
        <svg class="size-6 fill-none stroke-current" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
        </svg>
      )}
    </div>

    <!-- Tag Badge -->
    <div class="flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-[11px] font-mono tracking-wider font-semibold uppercase text-[#38bdf8]">
      <span class="size-1.5 rounded-full bg-[#38bdf8] animate-pulse"></span>
      <span>{type}</span>
    </div>

    <!-- Label -->
    <div class="flex flex-col gap-0.5">
      <span class="text-sm font-semibold text-white/90 tracking-tight">{label}</span>
      {sublabel && (
        <span class="text-xs font-mono text-slate-400">{sublabel}</span>
      )}
    </div>
  </div>

  <!-- Dimension Indicator in Corner -->
  <div class="absolute bottom-2.5 right-3 text-[10px] font-mono text-slate-500">
    {aspectRatio}
  </div>
</div>
