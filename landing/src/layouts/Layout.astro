---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prosto — The Thumb-First Android Browser",
  description = "A fast, ergonomic, gesture-driven Android browser built for one-handed browsing. Instant dock gestures, search provider switcher, power-user shortcuts, and built-in ad blocking."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" 
      rel="stylesheet" 
    />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('prosto-theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          // If system explicitly prefers light, we can respect it or default to dark
          // Defaulting to dark as standard for dev tools, but honor explicit system light if unset
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Prosto Browser" />
    <meta name="theme-color" content="#111b33" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="relative min-h-screen bg-[var(--bg-canvas)] text-[var(--text-primary)] selection:bg-[#2271B3] selection:text-white transition-colors duration-200">
    <!-- Ambient background mesh gradients (matching Color.kt sereneSkyBackground) -->
    <div class="flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>
