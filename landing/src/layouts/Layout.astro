---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prosto Browser — Browsing Stripped to Pure Speed",
  description = "An ultra-fast, gesture-driven Android browser built for one hand. Floating dock at your thumb, swipe-to-switch search, and native adblocking — in just 4 MB."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" 
      rel="stylesheet" 
    />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Prosto Browser" />
    <meta name="theme-color" content="#060913" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="relative min-h-screen bg-[#060913] text-[#f8fafc] selection:bg-[#0284c7] selection:text-white">
    <div class="flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>
